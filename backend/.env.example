# Copy this file to .env and fill in local values.

APP_NAME=e-help
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Milvus
MILVUS_URI=
MILVUS_DB_NAME=e_help_db
MILVUS_COLLECTION_NAME=e_help_after_sale

# OpenAI-compatible provider used by embeddings/chat
CLOSE_API_KEY=
CLOSE_API_BASE_URL=
CLOSEAI_BASE_URL=

EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5

