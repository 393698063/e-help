# Copy this file to .env and fill in local values.

APP_NAME=e-help
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Milvus
MILVUS_URI=
MILVUS_DB_NAME=e_help_db
MILVUS_COLLECTION_NAME=e_help_after_sale

# OpenAI-compatible provider used by embeddings/chat
CLOSE_API_KEY=
CLOSE_API_BASE_URL=
CLOSEAI_BASE_URL=

EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5
INTENT_CONFIDENCE_THRESHOLD=0.65
REWRITE_HISTORY_TURNS=6

# Agent execution budget
AGENT_TIMEOUT_SECONDS=60
AGENT_RECURSION_LIMIT=20
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_TOOL_CALLS=12

# Tool timeouts
TOOL_MODEL_TIMEOUT_SECONDS=30
TOOL_EMBEDDING_TIMEOUT_SECONDS=15
TOOL_MILVUS_TIMEOUT_SECONDS=5
TOOL_MEMORY_TIMEOUT_SECONDS=3

# Retry
TOOL_MAX_RETRIES=2
TOOL_RETRY_INITIAL_DELAY_SECONDS=0.5
TOOL_RETRY_MAX_DELAY_SECONDS=4

# Payload limits
TOOL_MAX_QUERY_LENGTH=2000
TOOL_MAX_RESULT_CHARS=12000
TOOL_MAX_RETRIEVAL_TOP_K=10

# PostgreSQL connection pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SOCKET_TIMEOUT_SECONDS=30
DB_RECONNECT_TIMEOUT_SECONDS=30

# Runtime Skill loading and administration
# Comma-separated absolute directories containing <skill-name>/SKILL.md.
SKILL_LOCAL_ROOTS=
SKILL_STORAGE_PATH=/app/skills
SKILL_MAX_BYTES=256000
SKILL_REQUEST_TIMEOUT_SECONDS=10
# Required for /api/skills management endpoints.
SKILL_ADMIN_TOKEN=
